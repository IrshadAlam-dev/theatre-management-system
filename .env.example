# Copy this file to .env and replace the example passwords.
MYSQL_DATABASE=theatre_management
MYSQL_USER=theatre_app
MYSQL_PASSWORD=replace_with_a_local_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_root_password

DB_URL=jdbc:mysql://localhost:3307/theatre_management
DB_USERNAME=theatre_app
DB_PASSWORD=replace_with_a_local_password
SERVER_PORT=8080

# Minutes before showtime after which unpaid cancellations and cash refunds close.
# Set to 0 to allow them until the show starts.
BOOKING_CANCELLATION_CUTOFF_MINUTES=0
BOOKING_REFUND_CUTOFF_MINUTES=0

# Generate with: openssl rand -base64 32
JWT_SECRET_BASE64=replace_with_a_generated_secret

# Optional: set both to create the first admin account on startup.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace_with_a_strong_local_password
